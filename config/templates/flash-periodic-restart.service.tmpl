[Unit]
Description=FLASH periodic restart script
StartLimitIntervalSec=0
After=flash-run-on-boot.service

[Service]
ExecStart=/bin/bash {{HOME_DIR}}/flash-tv-scripts/services/flash_periodic_restart.sh
StandardOutput=append:{{DATA_DIR}}/{{FULL_ID}}_flash_logstdoutp.log
StandardError=append:{{DATA_DIR}}/{{FULL_ID}}_flash_logstderrp.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
